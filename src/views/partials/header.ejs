    <% } else if (role === "VOTER") { %>
      <nav>
        <a href="/voter">ลงคะแนน</a>
        <a href="/voter/result">สรุปผลคะแนน</a>
        <a href="/">เปลี่ยนสิทธิ์ผู้ใช้งาน</a>
      </nav>
    <% } else { %>
      <nav><a href="/">เลือกสิทธิ์ผู้ใช้งาน</a></nav>
    <% } %>
  </div>
</header>
